<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Trocabook" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores principais que se adaptam automaticamente -->
        <item name="colorPrimary">#673AB7</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#03DAC6</item>
        <item name="colorOnSecondary">#000000</item>
        
        <!-- Superfícies que reduzem a saturação no modo escuro -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Trocabook" parent="Base.Theme.Trocabook" />
</resources>